&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="border: 1px solid #ddd; padding: 8px 12px; white-space: nowrap;"&gt;Taiwan&lt;/td&gt;
&lt;td style="border: 1px solid #ddd; padding: 8px 12px; white-space: nowrap;"&gt;No restriction&lt;/td&gt;

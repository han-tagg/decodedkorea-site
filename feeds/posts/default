&lt;th style="border: 1px solid #ddd; padding: 8px 12px; background-color: #f5f5f5; text-align: left; font-weight: bold; white-space: nowrap;"&gt;SLS&lt;/th&gt;
&lt;th style="border: 1px solid #ddd; padding: 8px 12px; background-color: #f5f5f5; text-align: left; font-weight: bold; white-space: nowrap;"&gt;SLES&lt;/th&gt;
&lt;/tr&gt;
&lt;/thead&gt;
